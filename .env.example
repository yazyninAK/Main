# Скопируйте этот файл в .env (в той же папке) и заполните значениями.
# .env добавлен в .gitignore — он никогда не попадёт в репозиторий.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Personal Access Token с правами на issues в репозитории yazyninAK/Main
# (Settings -> Developer settings -> Personal access tokens -> Fine-grained,
# права: Issues: Read and write, для репозитория Main).
GITHUB_TOKEN=
GITHUB_REPOSITORY=yazyninAK/Main
GITHUB_NOTIFY_USER=yazyninAK

# false — показывать окно браузера при каждом запуске (может помочь обойти
# защиту сайта, т.к. выглядит более "по-настоящему"). true — в фоне, без окна.
SCRAPER_HEADLESS=true
